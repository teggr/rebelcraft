<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.teggr</groupId>
        <artifactId>rebelcraft</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>rebelcraft-website</artifactId>
    <name>RebelCraft Electrostatic website</name>
    <description>Electrostatic content and site build for the RebelCraft showcase.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.teggr</groupId>
            <artifactId>rebelcraft-showcase-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-electrostatic-content</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/site-source</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/main/resources/site</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>assemble-site-assets</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>io.github.teggr.rebelcraft.website.SiteAssetGenerator</mainClass>
                            <classpathScope>runtime</classpathScope>
                            <arguments>
                                <argument>${project.build.directory}/site-source</argument>
                                <argument>${project.basedir}/../showcase-plugin/target/html-catalog</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.github.teggr</groupId>
                <artifactId>electrostatic-maven-plugin</artifactId>
                <version>${electrostatic.version}</version>
                <executions>
                    <execution>
                        <id>generate-electrostatic-site</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputDirectory>${project.build.directory}/site-source</inputDirectory>
                            <outputDirectory>${project.build.directory}/generated-site</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
